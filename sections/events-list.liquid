{% comment %}
  Events List
  -----------
  Lists all Event metaobject entries (type handle: events) in one
  grid — Upcoming (soonest first), then Past (most recent first).
  Each card carries a status tag since there's no longer a tab to
  group them visually. Which bucket/tag an event gets is decided by
  its own `status` field (Past/Upcoming) — set by the merchant on
  each entry, not computed from event_date.

  ponytail: switched from two tabbed panels to a single combined
  grid since there are only a couple of events right now; if the
  list grows large enough that Upcoming/Past filtering becomes
  useful again, reintroduce tabs (see git history for the old
  CSS-only tab markup) rather than adding a filter framework.

  ponytail: shop.metaobjects.events.values is paginated to 250
  entries here — plenty for a venue's events, but if the list ever
  grows past that, swap the {% paginate %} block for multi-page
  fetching (or a "load more" control).
{% endcomment %}

{%- liquid
  assign upcoming_keys = ''
  assign past_keys = ''
-%}

{%- paginate shop.metaobjects.events.values by 250 -%}
  {%- for event in shop.metaobjects.events.values -%}
    {%- assign event_day = event.event_date.value | date: '%Y-%m-%d' -%}
    {%- assign sort_key = event_day | append: '|' | append: event.system.handle -%}
    {%- if event.status.value == 'Upcoming' -%}
      {%- assign upcoming_keys = upcoming_keys | append: sort_key | append: ',' -%}
    {%- else -%}
      {%- assign past_keys = past_keys | append: sort_key | append: ',' -%}
    {%- endif -%}
  {%- endfor -%}
{%- endpaginate -%}

{%- assign upcoming_keys = upcoming_keys | split: ',' | sort -%}
{%- assign past_keys = past_keys | split: ',' | sort | reverse -%}

<div
  class="section section--page-width events-list"
  style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};"
>
  {%- if section.settings.heading != blank -%}
    <h2 class="events-list__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}

  {%- if upcoming_keys.size > 0 or past_keys.size > 0 -%}
    <div class="events-list__grid">
      {%- for key in upcoming_keys -%}
        {%- assign handle = key | split: '|' | last -%}
        {%- assign event = shop.metaobjects.events[handle] -%}
        {%- render 'event-card', event: event, upcoming: true -%}
      {%- endfor -%}
      {%- for key in past_keys -%}
        {%- assign handle = key | split: '|' | last -%}
        {%- assign event = shop.metaobjects.events[handle] -%}
        {%- render 'event-card', event: event, upcoming: false -%}
      {%- endfor -%}
    </div>
  {%- else -%}
    <p class="events-list__empty">{{ section.settings.empty_text | escape }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .events-list {
    padding-block: 40px 80px;
  }

  .events-list__heading {
    text-align: center;
    margin-bottom: 24px;
  }

  .events-list__grid {
    display: grid;
    grid-template-columns: repeat(var(--columns-mobile, 1), 1fr);
    gap: 32px;
  }

  @media (min-width: 750px) {
    .events-list__grid {
      grid-template-columns: repeat(var(--columns-desktop, 3), 1fr);
    }
  }

  .events-list__empty {
    text-align: center;
    padding: 40px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Events list",
  "tag": "section",
  "class": "section-events-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Events"
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "Empty state text",
      "default": "No events to show yet."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "1"
    }
  ],
  "presets": [
    {
      "name": "Events list"
    }
  ]
}
{% endschema %}
