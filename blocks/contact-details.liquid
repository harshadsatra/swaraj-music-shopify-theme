{%- doc -%}
  Shows the store's contact details. Email, phone and address come from Settings → General → Store details
  in the Shopify admin, and the company line from Theme settings → Business information, so editing either
  place updates this block without touching the page.
{%- enddoc -%}
{%- liquid
  assign phone_href = shop.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-'
  capture legal_line
    render 'business-legal-line'
  endcapture
  assign legal_line = legal_line | strip
  assign has_address = false
  if shop.address.address1 != blank or shop.address.city != blank
    assign has_address = true
  endif
-%}
<div
  class="contact-details contact-details--{{ block.settings.alignment }} size-style"
  style="{% render 'size-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
    <div class="contact-details__intro">
      {%- if block.settings.heading != blank -%}
        <h2 class="contact-details__heading {{ block.settings.heading_size }}">{{ block.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if block.settings.subheading != blank -%}
        <div class="contact-details__subheading rte">{{ block.settings.subheading }}</div>
      {%- endif -%}
    </div>
  {%- endif -%}
  <dl class="contact-details__list">
    {%- if block.settings.show_email and shop.email != blank -%}
      <div class="contact-details__item">
        <dt>{{ 'business_info.email' | t }}</dt>
        <dd>
          <a href="mailto:{{ shop.email }}">{{ shop.email }}</a>
        </dd>
      </div>
    {%- endif -%}
    {%- if block.settings.show_phone and shop.phone != blank -%}
      <div class="contact-details__item">
        <dt>{{ 'business_info.phone' | t }}</dt>
        <dd>
          <a href="tel:{{ phone_href }}">{{ shop.phone }}</a>
        </dd>
      </div>
    {%- endif -%}
    {%- if block.settings.show_address and has_address -%}
      <div class="contact-details__item">
        <dt>{{ 'business_info.address' | t }}</dt>
        <dd class="contact-details__address">
          {%- if shop.address.address1 != blank -%}{{ shop.address.address1 | escape }}<br>{%- endif -%}
          {%- if shop.address.address2 != blank -%}{{ shop.address.address2 | escape }}<br>{%- endif -%}
          {%- if shop.address.city != blank or shop.address.zip != blank -%}
            {{- shop.address.city | escape }} {{ shop.address.zip | escape -}}<br>
          {%- endif -%}
          {{- shop.address.country | escape -}}
        </dd>
      </div>
    {%- endif -%}
  </dl>
  {%- if block.settings.show_legal_info and legal_line != blank -%}
    <p class="contact-details__legal">{{ legal_line }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .contact-details {
    min-width: 0;
  }

  .contact-details--left {
    text-align: start;
  }

  .contact-details--center {
    text-align: center;
  }

  .contact-details__intro {
    margin-bottom: 2rem;
  }

  .contact-details__heading {
    margin: 0 0 0.75rem;
  }

  .contact-details__subheading {
    color: var(--color-foreground-muted, inherit);
  }

  .contact-details__subheading > :first-child {
    margin-top: 0;
  }

  .contact-details__subheading > :last-child {
    margin-bottom: 0;
  }

  .contact-details__list {
    display: grid;
    gap: 1rem;
    margin: 0;
  }

  .contact-details__item dt {
    font-weight: 600;
    margin-bottom: 0.25rem;
  }

  .contact-details__item dd {
    margin: 0;
  }

  .contact-details__address p {
    margin: 0;
  }

  .contact-details__legal {
    margin: 1.5rem 0 0;
    font-size: 0.875em;
    color: var(--color-foreground-muted, inherit);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Contact details",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "Email, phone and address come from Settings → General → Store details in the Shopify admin. The company line comes from Theme settings → Business information."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get in touch"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        { "value": "h2", "label": "Large" },
        { "value": "h3", "label": "Medium" },
        { "value": "h4", "label": "Small" }
      ],
      "default": "h3"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Questions about an order, sizing or returns? Send us a message using the form, or reach us directly below. We'll get back to you as soon as we can.</p>"
    },
    {
      "type": "header",
      "content": "Contact information"
    },
    {
      "type": "checkbox",
      "id": "show_email",
      "label": "Show email",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Show phone",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_address",
      "label": "Show address",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_legal_info",
      "label": "Show company details",
      "info": "The footer already shows these on every page.",
      "default": false
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width on desktop",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "Width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 40,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "Width on mobile",
      "options": [
        { "value": "fit-content", "label": "Fit content" },
        { "value": "custom", "label": "Custom" }
      ],
      "default": "custom"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "Width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "Contact details"
    }
  ]
}
{% endschema %}
